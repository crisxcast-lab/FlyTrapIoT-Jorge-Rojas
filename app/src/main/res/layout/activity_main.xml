<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F1F8E9">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FlyTrap IoT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:padding="15dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sistema de monitoreo de trampas inteligentes"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="15dp"/>

    <Button
        android:id="@+id/btnAgregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AGREGAR TRAMPA"
        android:backgroundTint="#388E3C"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listado de trampas registradas"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="10dp"/>

    <ListView
        android:id="@+id/listViewTrampas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#A5D6A7"
        android:dividerHeight="2dp"/>

</LinearLayout>
